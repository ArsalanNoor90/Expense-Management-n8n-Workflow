    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet totalSpending = 0;\nconst categoryTotals = {};\n\n// Process all records\nitems.forEach(item => {\n  const amount = parseFloat(item.json.Amount || item.json.amount || 0);\n  const category = item.json.Category || item.json.category || 'Uncategorized';\n  \n  totalSpending += amount;\n  \n  if (!categoryTotals[category]) {\n    categoryTotals[category] = 0;\n  }\n  categoryTotals[category] += amount;\n});\n\n// Format category totals for better UI display\nconst formattedCategories = {};\nObject.keys(categoryTotals).forEach(cat => {\n  formattedCategories[cat] = {\n    amount: categoryTotals[cat],\n    formatted: `$${categoryTotals[cat].toFixed(2)}`\n  };\n});\n\nreturn [{\n  json: {\n    summary: {\n      total_spending: totalSpending,\n      total_spending_formatted: `$${totalSpending.toFixed(2)}`,\n      total_transactions: items.length\n    },\n    category_breakdown: formattedCategories,\n    raw_category_totals: categoryTotals\n  }\n}];"
      },
